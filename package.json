{
  "name": "garage-interrupt",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/verify-data.ts && next build",
    "test": "tsx --test tests/*.test.ts",
    "verify": "tsx scripts/verify-data.ts",
    "freeze": "tsx scripts/freeze.ts",
    "audit:publication": "tsx scripts/audit-publication.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run verify",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "ingest": "tsx scripts/ingest.ts",
    "score": "tsx scripts/score.ts",
    "analyze": "tsx scripts/analyze.ts",
    "label-sample": "tsx scripts/label-sample.ts",
    "benchmark": "tsx scripts/benchmark.ts"
  },
  "dependencies": {
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/yauzl": "^3.4.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "puppeteer-core": "^25.12.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
